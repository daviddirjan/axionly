---
/**
 * The commercial ladder, shown before the detailed tier cards.
 *
 * Its job is to make the entry point obvious: 2.500 € is a large first step for a
 * company that does not know us yet, so the ladder leads with the Readiness Check
 * and shows the full range in one glance.
 */
interface Rung {
  step:     string;
  name:     string;
  price:    string;
  duration: string;
  role:     string;
  href:     string;
  current?: boolean;
}

interface Props {
  rungs: Rung[];
  ariaLabel: string;
}

const { rungs, ariaLabel } = Astro.props;
---

<ol class="ladder" aria-label={ariaLabel}>
  {rungs.map(rung => (
    <li class:list={['rung', { 'rung--current': rung.current }]}>
      <a href={rung.href}>
        <span class="rung-step">{rung.step}</span>
        <span class="rung-name">{rung.name}</span>
        <span class="rung-price">{rung.price}</span>
        <span class="rung-duration">{rung.duration}</span>
        <span class="rung-role">{rung.role}</span>
      </a>
    </li>
  ))}
</ol>

<style>
  .ladder {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    counter-reset: rung;
  }

  .rung a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    height: 100%;
    padding: 1.25rem;
    background-color: var(--color-white);
    border: 1.5px solid var(--color-container);
    border-radius: var(--radius-card);
    border-top: 4px solid var(--color-container);
    color: inherit;
    transition: border-color var(--transition), transform var(--transition);
  }

  .rung a:hover,
  .rung a:focus-visible {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .rung--current a {
    border-color: var(--color-accent);
    border-top-color: var(--color-accent);
  }

  .rung-step {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .rung-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
  }

  .rung-price {
    font-family: var(--font-logo);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-top: 0.35rem;
  }

  .rung-duration {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .rung-role {
    margin-top: 0.65rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--color-container);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .ladder { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 520px) {
    .ladder { grid-template-columns: 1fr; }
  }
</style>

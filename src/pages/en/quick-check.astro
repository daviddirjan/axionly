---
import BaseLayout  from '../../layouts/BaseLayout.astro';
import Header      from '../../components/Header.astro';
import Footer      from '../../components/Footer.astro';
import PageHeader  from '../../components/shared/PageHeader.astro';
import QuickCheck  from '../../components/quick-check/QuickCheck.astro';
import { QUESTIONS } from '../../config/quick-check';
import { PRICES } from '../../config/site';

const total = QUESTIONS.length;
---

<BaseLayout
  htmlLang="en"
  title="AI Act Quick Check — free self-assessment — Axionly"
  description={`A free ${total}-question self-assessment. Get an orientative indication of your organisation's EU AI Act exposure and three things to do first. Result shown immediately, no email required.`}
  canonicalPath="/en/quick-check"
  hreflangEN="/en/quick-check"
  hreflangRO="/evaluare-rapida"
>
  <Header />
  <main>

    <PageHeader
      eyebrow="Free tool"
      heading="AI Act Quick Check"
      subheading={`${total} questions, about three minutes. You get an orientative read on where your organisation sits and the three things we would address first. No email required to see your result.`}
    />

    <section id="quick-check">
      <div class="container">
        <QuickCheck
          lang="en"
          redirect="/en/quick-check/?sent=1"
          privacyHref="/en/privacy"
          readinessHref="/en/readiness-check"
          contactHref="/en/contact"
        />
      </div>
    </section>

    <section id="after">
      <div class="container after-inner">
        <h2>This is a starting point, not an answer.</h2>
        <p>
          A questionnaire can only work with what you already know. It cannot see the AI features
          buried in software you bought for something else, and it cannot tell you which specific
          obligations apply to a specific system. That is what the
          {' '}<a href="/en/readiness-check">{PRICES.readiness.en} Readiness Check</a> is for — and if
          you would rather just talk it through, the
          {' '}<a href="/en/contact">20-minute call is free</a>.
        </p>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
  #quick-check { background-color: var(--color-bg); }

  #after { background-color: var(--color-container); }

  .after-inner { max-width: 720px; }

  .after-inner h2 {
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    color: var(--color-text);
  }

  .after-inner p {
    margin-top: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .after-inner a { color: var(--color-accent-dark); font-weight: 600; }
</style>

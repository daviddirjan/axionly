---
import BaseLayout  from '../layouts/BaseLayout.astro';
import Header      from '../components/Header.astro';
import Footer      from '../components/Footer.astro';
import PageHeader  from '../components/shared/PageHeader.astro';
import QuickCheck  from '../components/quick-check/QuickCheck.astro';
import { QUESTIONS } from '../config/quick-check';
import { PRICES } from '../config/site';

const total = QUESTIONS.length;
---

<BaseLayout
  title="Evaluare rapidă AI Act — autoevaluare gratuită — Axionly"
  description={`O autoevaluare gratuită cu ${total} întrebări. Aflați orientativ care este expunerea organizației dumneavoastră față de Regulamentul UE privind IA și primele trei lucruri de făcut. Rezultatul apare imediat, fără email.`}
  htmlLang="ro"
  canonicalPath="/evaluare-rapida"
  hreflangEN="/en/quick-check"
  hreflangRO="/evaluare-rapida"
>
  <Header />
  <main>

    <PageHeader
      eyebrow="Instrument gratuit"
      heading="Evaluare rapidă AI Act"
      subheading={`${total} întrebări, aproximativ trei minute. Primiți o citire orientativă a situației organizației dumneavoastră și primele trei lucruri de care ne-am ocupa. Nu este nevoie de email ca să vedeți rezultatul.`}
    />

    <section id="quick-check">
      <div class="container">
        <QuickCheck
          lang="ro"
          redirect="/evaluare-rapida/?sent=1"
          privacyHref="/privacy"
          readinessHref="/readiness-check"
          contactHref="/contact"
        />
      </div>
    </section>

    <section id="after">
      <div class="container after-inner">
        <h2>Acesta este un punct de plecare, nu un răspuns.</h2>
        <p>
          Un chestionar poate lucra doar cu ceea ce știți deja. Nu poate vedea funcțiile AI ascunse
          în software cumpărat pentru altceva și nu vă poate spune ce obligații concrete se aplică
          unui anumit sistem. Pentru asta există
          {' '}<a href="/readiness-check">AI Act Readiness Check, {PRICES.readiness.ro}</a> — iar
          dacă preferați pur și simplu să discutați,
          {' '}<a href="/contact">apelul de 20 de minute este gratuit</a>.
        </p>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
  #quick-check { background-color: var(--color-bg); }

  #after { background-color: var(--color-container); }

  .after-inner { max-width: 720px; }

  .after-inner h2 {
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    color: var(--color-text);
  }

  .after-inner p {
    margin-top: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .after-inner a { color: var(--color-accent-dark); font-weight: 600; }
</style>

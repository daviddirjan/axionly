---
import BaseLayout   from '../layouts/BaseLayout.astro';
import Header       from '../components/Header.astro';
import Footer       from '../components/Footer.astro';
import PageHeader   from '../components/shared/PageHeader.astro';
import CtaBanner    from '../components/shared/CtaBanner.astro';
import { PRICES, DELIVERY, CREDIT_WINDOW_DAYS } from '../config/site';

const price    = PRICES.readiness.ro;
const delivery = DELIVERY.readiness.ro;

const deliverable = [
  'Un inventar al sistemelor AI pe care organizația dumneavoastră le folosește efectiv — inclusiv cele adoptate fără avizul IT sau juridic.',
  'O încadrare preliminară a fiecărui sistem pe categoriile de risc din Regulamentul UE privind IA, cu raționamentul explicat.',
  'Primele trei acțiuni pe care le-am prioritiza, cu o indicație de efort și de urgență pentru fiecare.',
];

const steps = [
  {
    number: '01',
    name:   'O sesiune de lucru de 90 de minute',
    body:   'Un singur apel cu persoana care știe cum lucrează efectiv echipele dumneavoastră — de regulă cineva din operațiuni, IT sau conducere. Fără pregătire prealabilă, fără documente de adunat în avans.',
  },
  {
    number: '02',
    name:   'Facem analiza',
    body:   'Luăm ce a rezultat din sesiune și îl raportăm la categoriile de risc din Regulamentul UE privind IA și la obligațiile care par să decurgă din acestea.',
  },
  {
    number: '03',
    name:   'Primiți un document de cinci pagini',
    body:   `Livrat în ${delivery}. Scris în limbaj simplu, adresat unui decident, nu unui jurist.`,
  },
];

const whoFor = [
  'Știți că echipele folosesc instrumente AI, dar nimeni nu a notat care anume.',
  'Cineva a întrebat dacă Regulamentul UE privind IA vi se aplică, iar răspunsul sincer este că nimeni nu știe sigur.',
  'Vreți să știți dimensiunea problemei înainte de a vă angaja la o evaluare completă.',
  'Aveți nevoie de ceva concret pe care să îl duceți într-o ședință de conducere sau de consiliu.',
];
---

<BaseLayout
  title={`AI Act Readiness Check — ${price} — Axionly`}
  description={`Un punct de plecare de ${price} înaintea unei evaluări complete: o sesiune de 90 de minute și un document de cinci pagini cu inventarul sistemelor AI, încadrarea preliminară pe categorii de risc din Regulamentul UE privind IA și primele trei acțiuni recomandate. Livrat în ${delivery}.`}
  htmlLang="ro"
  canonicalPath="/readiness-check"
  hreflangEN="/en/readiness-check"
  hreflangRO="/readiness-check"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AI Act Readiness Check",
    "provider": { "@id": "https://axionly.io/#organization" },
    "description": "O sesiune de lucru de 90 de minute plus un document de cinci pagini: inventarul sistemelor AI folosite, încadrarea preliminară pe categoriile de risc din Regulamentul UE privind IA și primele trei acțiuni recomandate. Livrat în trei zile lucrătoare.",
    "areaServed": "Europe",
    "serviceType": ["AI Act Readiness Check", "Conformitate Regulament UE privind IA", "Consultanță Guvernanță AI"],
    "inLanguage": "ro",
    "offers": {
      "@type": "Offer",
      "name": "AI Act Readiness Check",
      "price": PRICES.readiness.raw,
      "priceCurrency": "EUR",
      "description": `Serviciu de intrare. Costul se scade integral din prețul unei Evaluări complete de risc AI dacă se continuă în ${CREDIT_WINDOW_DAYS} de zile.`
    }
  })} />
  <Header />
  <main>

    <PageHeader
      eyebrow="Pasul unu"
      heading="AI Act Readiness Check"
      subheading="Înainte de a vă angaja la o evaluare completă, aflați cât de mare este de fapt întrebarea. Nouăzeci de minute din timpul nostru, un document de cinci pagini și o imagine clară a situației."
    />

    <!-- Rezumatul ofertei -->
    <section id="offer">
      <div class="container offer-grid">

        <div class="offer-text">
          <p class="section-label">Ce primiți</p>
          <h2>O citire scurtă și onestă a expunerii dumneavoastră.</h2>
          <p class="lead">
            Majoritatea organizațiilor cu care discutăm nu ne cer încă să reparăm ceva. Pun o
            întrebare mai simplă: ni se aplică acest regulament și cât de grav? Readiness Check
            răspunde la această întrebare și la nimic mai mult.
          </p>
          <ul class="deliverable">
            {deliverable.map(item => (
              <li>
                <span class="check" aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p class="caveat">
            Aceasta este o imagine preliminară, nu o opinie juridică și nu înlocuiește o evaluare
            completă. Acolo unde încadrarea este cu adevărat incertă, spunem asta în loc să
            presupunem.
          </p>
        </div>

        <aside class="offer-card" aria-label="Prețul serviciului Readiness Check">
          <p class="card-name">AI Act Readiness Check</p>
          <p class="card-price">{price}</p>
          <p class="card-price-note">preț fix, fără costuri suplimentare</p>
          <dl class="card-facts">
            <div><dt>Timpul dumneavoastră</dt><dd>90 de minute</dd></div>
            <div><dt>Livrabil</dt><dd>document de 5 pagini</dd></div>
            <div><dt>Termen</dt><dd>{delivery}</dd></div>
          </dl>
          <a href="/contact" class="btn-primary card-cta">Rezervați un Readiness Check</a>
          <p class="card-foot">
            Încă nu sunteți sigur? Apelul de descoperire de 20 de minute este gratuit și vine
            oricum primul.
          </p>
        </aside>

      </div>
    </section>

    <!-- Deducerea costului -->
    <section id="credit">
      <div class="container credit-inner">
        <div class="credit-badge" aria-hidden="true">↺</div>
        <div>
          <h2>Costul se scade din evaluarea completă.</h2>
          <p>
            Dacă decideți să continuați cu o Evaluare completă de risc AI în {CREDIT_WINDOW_DAYS}
            de zile de la primirea documentului, cei {price} se scad integral din prețul evaluării.
            Nu plătiți de două ori același punct de plecare — iar dacă Readiness Check arată că nu
            aveți nevoie de o evaluare completă, vă spunem și asta.
          </p>
          <a href="/services" class="credit-link">Vedeți toate serviciile →</a>
        </div>
      </div>
    </section>

    <!-- Cum decurge -->
    <section id="process">
      <div class="container">
        <h2 class="section-heading">Cum decurge</h2>
        <ol class="steps">
          {steps.map(step => (
            <li class="step">
              <span class="step-number">{step.number}</span>
              <div>
                <h3>{step.name}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Pentru cine -->
    <section id="who">
      <div class="container">
        <h2 class="section-heading">Începeți aici dacă…</h2>
        <ul class="who-list">
          {whoFor.map(item => (
            <li><span class="who-arrow" aria-hidden="true">→</span><span>{item}</span></li>
          ))}
        </ul>
        <p class="who-note">
          Dacă aveți deja un inventar al sistemelor AI și știți care sisteme intră în domeniul de
          aplicare, săriți peste acest pas și mergeți direct la
          <a href="/services">evaluarea completă</a>. Dacă nu sunteți sigur că acesta este
          pasul potrivit, <a href="/evaluare-rapida">evaluarea rapidă AI Act</a> este gratuită
          și durează trei minute.
        </p>
      </div>
    </section>

    <CtaBanner
      heading="Nouăzeci de minute ca să știți unde vă aflați."
      subtext="Începeți cu apelul gratuit de descoperire de 20 de minute. Confirmăm dacă Readiness Check este primul pas potrivit pentru dumneavoastră — sau vă spunem sincer dacă nu este."
      ctaLabel="Rezervați un Apel Gratuit"
      ctaHref="/contact"
    />

  </main>
  <Footer />
</BaseLayout>

<style>
  .section-heading {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin-bottom: 2rem;
    color: var(--color-text);
  }

  /* ── Offer ─────────────────────────────────────────────────────────────── */
  #offer { background-color: var(--color-bg); }

  .offer-grid {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 3rem;
    align-items: start;
  }

  .offer-text h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin-top: 0.5rem;
    color: var(--color-text);
  }

  .lead { margin-top: 1rem; color: var(--color-text-muted); }

  .deliverable {
    list-style: none;
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .deliverable li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .check {
    color: var(--color-accent);
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 0.15em;
  }

  .caveat {
    margin-top: 1.75rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-container);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .offer-card {
    background-color: var(--color-white);
    border: 1.5px solid var(--color-accent);
    border-radius: var(--radius-card);
    padding: 2rem;
    box-shadow: 0 4px 32px rgba(53, 147, 255, 0.12);
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
  }

  .card-name { font-size: 1rem; font-weight: 700; color: var(--color-text); }

  .card-price {
    font-family: var(--font-logo);
    font-size: 2.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-top: 0.75rem;
  }

  .card-price-note { font-size: 0.8125rem; color: var(--color-text-muted); }

  .card-facts {
    margin-top: 1.5rem;
    border-top: 1px solid var(--color-container);
    padding-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .card-facts > div { display: flex; justify-content: space-between; gap: 1rem; }
  .card-facts dt { font-size: 0.875rem; color: var(--color-text-muted); }
  .card-facts dd { font-size: 0.875rem; font-weight: 600; color: var(--color-text); text-align: right; }

  .card-cta { width: 100%; margin-top: 1.5rem; text-align: center; justify-content: center; }

  .card-foot {
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* ── Credit ────────────────────────────────────────────────────────────── */
  #credit { background-color: var(--color-container); }

  .credit-inner {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    max-width: 900px;
  }

  .credit-badge {
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background-color: var(--color-accent);
    color: var(--color-white);
    display: grid;
    place-items: center;
    font-size: 1.5rem;
    line-height: 1;
  }

  .credit-inner h2 { font-size: clamp(1.35rem, 2.2vw, 1.75rem); color: var(--color-text); }
  .credit-inner p  { margin-top: 0.75rem; color: var(--color-text-muted); }

  .credit-link {
    display: inline-block;
    margin-top: 1rem;
    color: var(--color-accent-dark);
    font-weight: 600;
  }

  /* ── Process ───────────────────────────────────────────────────────────── */
  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .step { display: flex; gap: 1rem; align-items: flex-start; }

  .step-number {
    font-family: var(--font-logo);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
    flex-shrink: 0;
  }

  .step h3 { font-size: 1.0625rem; font-weight: 700; color: var(--color-text); }
  .step p  { margin-top: 0.5rem; font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.65; }

  /* ── Who ───────────────────────────────────────────────────────────────── */
  #who { background-color: var(--color-bg); }

  .who-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-width: 760px;
  }

  .who-list li { display: flex; gap: 0.75rem; align-items: flex-start; color: var(--color-text-muted); line-height: 1.65; }

  .who-arrow { color: var(--color-accent); font-weight: 700; flex-shrink: 0; }

  .who-note {
    margin-top: 1.75rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .who-note a { color: var(--color-accent); font-weight: 600; }

  @media (max-width: 900px) {
    .offer-grid { grid-template-columns: 1fr; }
    .offer-card { position: static; }
    .steps { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>

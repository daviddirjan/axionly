---
import BaseLayout       from '../layouts/BaseLayout.astro';
import Header           from '../components/Header.astro';
import Footer           from '../components/Footer.astro';
import PageHeader       from '../components/shared/PageHeader.astro';
import ServiceTier      from '../components/services/ServiceTier.astro';
import ComparisonTable  from '../components/services/ComparisonTable.astro';
import PricingLadder    from '../components/services/PricingLadder.astro';
import CtaBanner        from '../components/shared/CtaBanner.astro';
import { PRICES, DELIVERY, CREDIT_WINDOW_DAYS } from '../config/site';

const standardIncludes = [
  'Inventar Sisteme AI — registru complet cu clasificare de risc conform Regulamentului UE privind IA',
  'Analiză Lacune Regulament UE privind IA — obligații cartografiate, lacune identificate, articole aplicabile citate',
  'Revizuire Guvernanță Date — modul în care datele cu caracter personal sunt gestionate de sistemele AI față de cerințele GDPR',
  'Evaluare Risc Furnizori — contracte și acorduri de procesare a datelor revizuite',
  'Revizuire Politică Internă — dacă o politică de utilizare AI există și dacă este adecvată',
  'Plan de Acțiune Prioritizat — acțiuni imediate, la 30 de zile și la 90 de zile, clasificate după risc',
  'Apel de Prezentare Executivă — prezentare de 30 de minute cu principalii factori de decizie',
];

const deepDiveIncludes = [
  ...standardIncludes,
  'Testare Injecție Prompt — dacă sistemele AI sunt vulnerabile la atacuri de injecție de prompt',
  'Revizuire API și Control Acces — configurarea API-urilor AI, drepturile de acces și gestionarea cheilor',
  'Evaluare Risc Scurgeri de Date — dacă datele sensibile transmise instrumentelor AI pot fi expuse',
  'Revizuire Răspuns la Incidente AI — dacă organizația poate detecta și răspunde la incidente de securitate AI',
];

const ladder = [
  {
    step: 'Pasul 1', name: 'AI Act Readiness Check',
    price: PRICES.readiness.ro, duration: DELIVERY.readiness.ro,
    role: 'Punctul de plecare. Aflați dacă și cum vi se aplică regulamentul.',
    href: '/readiness-check',
  },
  {
    step: 'Pasul 2', name: 'Evaluare de Risc AI',
    price: PRICES.assessment.ro, duration: DELIVERY.assessment.ro,
    role: 'Angajamentul complet. Obligații cartografiate, lacune identificate, acțiuni prioritizate.',
    href: '#service-tiers', current: true,
  },
  {
    step: 'Pasul 2+', name: 'Evaluare + Analiză Aprofundată de Securitate',
    price: PRICES.deepDive.ro, duration: DELIVERY.assessment.ro,
    role: 'Evaluarea completă plus o revizuire tehnică de securitate a sistemelor AI.',
    href: '#service-tiers',
  },
  {
    step: 'Pasul 3', name: 'Abonament de Guvernanță',
    price: 'La cerere', duration: 'Continuu, lunar',
    role: 'Monitorizare continuă, actualizări de reglementare și sprijin la audit.',
    href: '#retainer',
  },
];

// NOTĂ (revizuire fondator): abonamentul nu are încă un preț lunar publicat — vezi
// blocantul B2 din NOTES.md. Este descris aici deliberat, înainte de a avea clienți
// pe el, pentru că este nivelul care produce venit recurent.
const retainerIncludes = [
  'Revizuire trimestrială de guvernanță — progresul față de planul de acțiune, urmărit și documentat.',
  'Monitorizare reglementară — vă spunem noi când se schimbă ceva care vă afectează sistemele, în loc să aflați din presă.',
  'Reevaluarea sistemelor AI noi pe măsură ce le adoptați, ca inventarul să nu rămână în urmă.',
  'Persoană de contact desemnată pentru întrebări de guvernanță AI între revizuiri.',
  'Sprijin în timpul auditurilor, al revizuirilor de securitate cerute de clienți și al solicitărilor de due diligence.',
];

const addOns = [
  { name: 'Redactare Politică de Utilizare AI',           desc: 'Redactăm politica internă de guvernanță AI pe baza constatărilor din audit.' },
  { name: 'Revizuire Trimestrială de Guvernanță',         desc: 'Un control trimestrial mai ușor pentru a urmări progresul și a semnala modificările reglementare. Pe bază de abonament.' },
  { name: 'Due Diligence Furnizori',                      desc: 'O analiză unică a unui produs AI specific pe care organizația dumneavoastră ia în considerare să îl achiziționeze.' },
  { name: 'Documentație Tehnică Regulament UE privind IA', desc: 'Pregătirea documentației tehnice necesare pentru sistemele AI cu risc ridicat. Prețul se stabilește în funcție de scopul proiectului.' },
];

const whoItIsFor = [
  'Utilizați instrumente AI, dar nu aveți o politică formală care să le reglementeze.',
  'Nu știți dacă sistemele dumneavoastră AI declanșează obligații conform Regulamentului UE privind IA.',
  'Procesați date ale clienților, angajaților sau date financiare prin platforme AI.',
  'Departamentul juridic, de conformitate sau conducerea pune întrebări despre riscul AI și aveți nevoie de un răspuns clar.',
  'Aveți un produs AI orientat către clienți și doriți conformitate înainte de a scala.',
  'Doriți să vă pregătiți pentru supravegherea reglementară înainte ca aceasta să vă fie impusă.',
];
---

<BaseLayout
  title="Servicii și Prețuri Evaluare AI Readiness — Axionly"
  description={`Servicii de guvernanță AI cu domeniu fix, de la ${PRICES.readiness.ro}: un AI Act Readiness Check de ${PRICES.readiness.ro}, o evaluare completă de risc AI de ${PRICES.assessment.ro} pentru conformitate cu Regulamentul UE privind IA, guvernanța datelor GDPR, securitate și risc de furnizori, plus un abonament de guvernanță continuă.`}
  htmlLang="ro"
  canonicalPath="/services"
  hreflangEN="/en/services"
  hreflangRO="/services"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Evaluare AI Readiness",
    "provider": { "@id": "https://axionly.io/#organization" },
    "description": "Un audit complet al sistemelor dumneavoastră AI care acoperă clasificarea conform Regulamentului UE privind IA, riscurile de guvernanță a datelor GDPR, vulnerabilitățile de securitate și expunerea față de furnizori. Livrat în cinci zile lucrătoare cu un raport scris și un plan de acțiune prioritizat.",
    "areaServed": "Europe",
    "serviceType": ["Evaluare AI Readiness", "Conformitate Regulament UE privind IA", "Consultanță Guvernanță AI", "Audit Securitate AI"],
    "offers": [
      {
        "@type": "Offer",
        "name": "AI Act Readiness Check",
        "price": PRICES.readiness.raw,
        "priceCurrency": "EUR",
        "description": `Serviciu de intrare: o sesiune de 90 de minute plus un document de cinci pagini cu inventarul sistemelor AI, încadrarea preliminară pe categoriile de risc din Regulamentul UE privind IA și primele trei acțiuni recomandate. Costul se scade din evaluarea completă în ${CREDIT_WINDOW_DAYS} de zile.`
      },
      {
        "@type": "Offer",
        "name": "Evaluare AI Readiness",
        "price": PRICES.assessment.raw,
        "priceCurrency": "EUR",
        "description": "Clasificare conform Regulamentului UE privind IA, revizuire guvernanță date GDPR, analiză expunere furnizori și raport scris cu plan de acțiune prioritizat."
      },
      {
        "@type": "Offer",
        "name": "Evaluare AI Readiness + Analiză Aprofundată de Securitate",
        "price": PRICES.deepDive.raw,
        "priceCurrency": "EUR",
        "description": "Tot ce include evaluarea standard plus o revizuire tehnică completă de securitate care acoperă vulnerabilități, suprafețe de atac și amenințări specifice AI."
      }
    ]
  })} />
  <Header />
  <main>

    <PageHeader
      eyebrow="Servicii"
      heading="Serviciile Noastre"
      subheading="Trei niveluri, de la un punct de plecare de 90 de minute până la sprijin continuu de guvernanță. Domeniu fix, preț fix, fără surprize."
    />

    <section id="ladder">
      <div class="container">
        <h2 class="section-heading">De unde începeți</h2>
        <p class="section-intro">
          Nu trebuie să începeți cu o evaluare completă. Majoritatea organizațiilor încep cu
          Readiness Check, iar costul se scade dacă merg mai departe.
        </p>
        <PricingLadder rungs={ladder} ariaLabel="Niveluri de servicii și prețuri" />
      </div>
    </section>

    <section id="entry-point">
      <div class="container entry-inner">
        <div>
          <p class="section-label">Pasul unu</p>
          <h2>Nu sunteți încă pregătit pentru o evaluare completă?</h2>
          <p>
            AI Act Readiness Check costă {PRICES.readiness.ro}: o sesiune de 90 de minute și un
            document de cinci pagini cu inventarul sistemelor AI, o încadrare preliminară pe
            categorii de risc și primele trei acțiuni de făcut. Livrat în
            {' '}{DELIVERY.readiness.ro}. Dacă treceți la o evaluare completă în
            {' '}{CREDIT_WINDOW_DAYS} de zile, costul se scade integral.
          </p>
        </div>
        <a href="/readiness-check" class="btn-primary entry-cta">Vedeți Readiness Check</a>
      </div>
    </section>

    <section id="service-tiers">
      <div class="container tiers-grid">
        <ServiceTier
          name="Evaluare de Pregătire AI"
          description="Un audit complet al sistemelor dumneavoastră AI, obligațiilor din Regulamentul UE privind IA, riscurilor de guvernanță a datelor și expunerii față de furnizori — livrat în cinci zile lucrătoare."
          price={PRICES.assessment.ro}
          delivery={`${DELIVERY.assessment.ro} de la apelul de delimitare`}
          deliveryLabel="Livrat în"
          includes={standardIncludes}
          ctaLabel="Rezervați un Apel de Descoperire Gratuit"
          ctaHref="/contact"
        />
        <ServiceTier
          name="Evaluare de Pregătire AI + Analiză Aprofundată de Securitate"
          description="Tot ce include evaluarea standard, plus o revizuire tehnică de securitate a sistemelor dumneavoastră AI — acoperind vulnerabilități, suprafețe de atac și amenințări specifice AI."
          price={PRICES.deepDive.ro}
          delivery={`${DELIVERY.assessment.ro} de la apelul de delimitare`}
          deliveryLabel="Livrat în"
          includes={deepDiveIncludes}
          highlight={true}
          highlightLabel="Cel mai complet"
          ctaLabel="Rezervați un Apel de Descoperire Gratuit"
          ctaHref="/contact"
        />
      </div>
    </section>

    <section id="comparison">
      <div class="container">
        <h2 class="section-heading">Ce este inclus în fiecare nivel</h2>
        <ComparisonTable lang="ro" />
      </div>
    </section>

    <section id="retainer">
      <div class="container">
        <p class="section-label">Pasul trei</p>
        <h2 class="section-heading">Abonament de Guvernanță</h2>
        <p class="section-intro">
          O evaluare vă spune unde vă aflați într-o anumită zi. Reglementarea se mișcă, la fel și
          sistemele dumneavoastră AI — echipele adoptă instrumente noi, furnizorii își schimbă
          termenii, apar ghiduri noi. Abonamentul menține imaginea actuală, în loc să o lase să
          expire.
        </p>
        <div class="retainer-card">
          <ul class="retainer-list">
            {retainerIncludes.map(item => (
              <li><span class="check" aria-hidden="true">✓</span><span>{item}</span></li>
            ))}
          </ul>
          <div class="retainer-aside">
            <p class="retainer-price">Preț la cerere</p>
            <p class="retainer-note">
              Dimensionat în funcție de amploarea sistemelor dumneavoastră AI și facturat lunar.
              Disponibil după o evaluare, astfel încât domeniul să se bazeze pe constatări, nu pe
              presupuneri.
            </p>
            <a href="/contact" class="btn-ghost">Întrebați despre abonament</a>
          </div>
        </div>
      </div>
    </section>

    <section id="add-ons">
      <div class="container">
        <h2 class="section-heading">Servicii opționale suplimentare</h2>
        <p class="section-intro">
          După un audit inițial, clienții pot necesita asistență suplimentară. Acestea sunt disponibile
          separat — nu incluse în oferta principală.
        </p>
        <ul class="addons-grid">
          {addOns.map(a => (
            <li class="addon-card">
              <h3>{a.name}</h3>
              <p>{a.desc} Preț la cerere.</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="who-its-for">
      <div class="container">
        <h2 class="section-heading">Acest serviciu este potrivit pentru organizația dumneavoastră dacă…</h2>
        <ul class="who-list">
          {whoItIsFor.map(item => (
            <li>
              <span class="who-check" aria-hidden="true">→</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <CtaBanner
      heading="Nu știți sigur care nivel vi se potrivește?"
      subtext="Rezervați un apel de descoperire gratuit de 20 de minute. Vom confirma ce intră în domeniu și care nivel se potrivește situației dumneavoastră — fără costuri și fără obligații."
      ctaLabel="Rezervați un Apel de Descoperire Gratuit"
      ctaHref="/contact"
    />

  </main>
  <Footer />
</BaseLayout>

<style>
  #service-tiers { background-color: var(--color-bg); padding-block: var(--space-section); }
  .tiers-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; align-items: start; }
  #comparison { background-color: var(--color-container); padding-block: var(--space-section); }
  #add-ons { background-color: var(--color-bg); padding-block: var(--space-section); }
  #who-its-for { background-color: var(--color-container); padding-block: var(--space-section); }
  .section-heading { font-size: clamp(1.3rem, 2.5vw, 1.75rem); color: var(--color-text); margin-bottom: 0.75rem; }
  .section-intro { color: var(--color-text-muted); margin-bottom: 2rem; max-width: 620px; line-height: 1.7; }
  .addons-grid { list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 2rem; }
  .addon-card { background-color: var(--color-container); border-radius: var(--radius-card); padding: 1.5rem; }
  .addon-card h3 { font-size: 1rem; font-weight: 700; color: var(--color-text); margin-bottom: 0.4rem; }
  .addon-card p  { font-size: 0.9rem; color: var(--color-text-muted); line-height: 1.6; }
  .who-list { list-style: none; display: flex; flex-direction: column; gap: 0.85rem; margin-top: 1.5rem; max-width: 720px; }
  .who-list li { display: flex; align-items: flex-start; gap: 0.9rem; font-size: 1rem; color: var(--color-text-muted); line-height: 1.6; }
  .who-check { color: var(--color-accent); font-weight: 700; flex-shrink: 0; margin-top: 0.1em; }
  @media (max-width: 768px) { .tiers-grid { grid-template-columns: 1fr; } .addons-grid { grid-template-columns: 1fr; } }

  /* ── Pricing ladder + entry point (Phase 3) ─────────────────────────── */
  #ladder { background-color: var(--color-bg); }

  #entry-point { background-color: var(--color-container); }

  .entry-inner {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    justify-content: space-between;
  }

  .entry-inner h2 {
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    margin-top: 0.5rem;
    color: var(--color-text);
  }

  .entry-inner p {
    margin-top: 0.75rem;
    color: var(--color-text-muted);
    max-width: 62ch;
  }

  .entry-cta { flex-shrink: 0; }

  /* ── Retainer ────────────────────────────────────────────────────────── */
  .retainer-card {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2.5rem;
    background-color: var(--color-white);
    border: 1.5px solid var(--color-container);
    border-radius: var(--radius-card);
    padding: 2rem;
  }

  .retainer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .retainer-list li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    color: var(--color-text-muted);
    line-height: 1.65;
    font-size: 0.9375rem;
  }

  .retainer-list .check {
    color: var(--color-accent);
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 0.15em;
  }

  .retainer-aside {
    border-left: 1px solid var(--color-container);
    padding-left: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .retainer-price {
    font-family: var(--font-logo);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .retainer-note {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .entry-inner { flex-direction: column; align-items: flex-start; }
    .retainer-card { grid-template-columns: 1fr; gap: 1.75rem; }
    .retainer-aside { border-left: none; border-top: 1px solid var(--color-container); padding-left: 0; padding-top: 1.75rem; }
  }
</style>
